# OpenGrammar Extension Environment Variables
# Copy this file to .env and fill in your values

# Optional: Backend API URL
# If not set, defaults to the public instance or your self-hosted URL
# VITE_BACKEND_URL=https://your-backend-url.workers.dev

# Optional: Default LLM Provider
# Options: openai, groq, together, openrouter, ollama, custom
# VITE_DEFAULT_PROVIDER=openai

# Optional: Default Model
# VITE_DEFAULT_MODEL=gpt-4o-mini

# Optional: Enable/Disable specific features
# VITE_ENABLE_AUTOCOMPLETE=true
# VITE_ENABLE_REWRITE=true
# VITE_ENABLE_STATS=true

# Optional: Analytics (disabled by default for privacy)
# VITE_ENABLE_ANALYTICS=false
